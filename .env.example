# E2B Sandbox Configuration
# Sign up at https://e2b.dev and get your API key from the dashboard
E2B_API_KEY=

# Neon Database Configuration
# Create a Postgres database at https://neon.tech and copy the connection string
# Format: postgresql://user:password@host/database
DATABASE_URL=

# Sandbox Runner Configuration
# If using local sandbox runner (sandbox-runner/) instead of E2B
SANDBOX_RUNNER_URL=https://your-runner.onrender.com
SANDBOX_RUNNER_TOKEN=your_runner_token_here

# Frontend sandbox runner URL (for client-side preview)
VITE_SANDBOX_RUNNER_URL=https://your-runner.onrender.com

# CORS Configuration
# Set to your app origin to restrict cross-origin requests
SANDBOX_ALLOW_ORIGIN=*
